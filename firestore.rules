rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lecture et écriture réservées aux utilisateurs connectés avec Google.
    // Pour un groupe privé, remplace la condition par une liste d'e-mails autorisés.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
